# Vercel project root: frontend
# Config values
PORTFOLIO_GATEWAY_PROXY=1
PORTFOLIO_MODE=1
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_UI_DEMO=0
PORTFOLIO_GATEWAY_ORIGIN=
PORTFOLIO_GATEWAY_TIMEOUT_SECONDS=110

# Secret value: set in Vercel as a server-only Secret, never with NEXT_PUBLIC_.
PORTFOLIO_GATEWAY_SECRET=

# Separate owner-only remote test. Never enable with PORTFOLIO_MODE=1.
PERSONAL_REMOTE_TEST=0
PERSONAL_REMOTE_PUBLIC_ORIGIN=
PERSONAL_REMOTE_GATEWAY_ORIGIN=
PERSONAL_REMOTE_GATEWAY_TIMEOUT_SECONDS=110

# Server-only Secret. Never prefix this name with NEXT_PUBLIC_.
PERSONAL_REMOTE_GATEWAY_SECRET=
