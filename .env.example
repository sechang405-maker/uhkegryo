# 어케그려 로컬 Docker Compose 설정
# 이 파일을 .env로 복사한 뒤 본인의 OPENROUTER_API_KEY만 반드시 입력하세요.
# 아래 기본값은 127.0.0.1에만 공개되는 개인 개발 환경용이며 공용 서버용 보안 설정이 아닙니다.

# 필수: 사용자 본인의 OpenRouter 키
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_TIMEOUT_SECONDS=180
WORKER_CONCURRENCY=5

# 기본값은 Compose 내부 app-db입니다. 외부 PostgreSQL/Neon을 사용할 때만 전체 URL을 입력하세요.
# 예: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
APP_POSTGRES_PASSWORD=uhkegryo-local-only

# localhost 포트. 이미 사용 중이면 사용하지 않는 값으로 바꿀 수 있습니다.
FRONTEND_PORT=3100
API_PORT=8000
MCP_PORT=8001
SEARXNG_PORT=8080

# 기본 검색 서비스. 알려진 예시값이므로 인터넷에 노출하는 배포에는 사용하지 마세요.
SEARXNG_SECRET=uhkegryo-local-search-only
# CI나 격리 검증에서만 별도 이미지 태그가 필요할 때 사용합니다.
# SEARXNG_IMAGE=proj2-4/searxng:local

# 구조화 해석 Prompt. 둘 중 하나만 설정하면 API 시작이 거부됩니다.
INTERPRETER_PROMPT_PATH=./prompts/uhkegryo-interpreter-v4.md
INTERPRETER_PROMPT_VERSION=uhkegryo-interpreter-v4

# 선택: docker compose --profile observability up --build -d
# 기본 앱 실행에는 아래 값이 필요하지 않습니다. profile을 공유 환경에서 쓸 때는 모두 교체하세요.
LANGFUSE_PORT=3000
LANGFUSE_MINIO_PORT=9090
LANGFUSE_APP_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=langfuse-local-only-nextauth
LANGFUSE_SALT=langfuse-local-only-salt
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_POSTGRES_PASSWORD=langfuse-local-only
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse-local-only
LANGFUSE_REDIS_AUTH=langfuse-local-only
LANGFUSE_MINIO_ROOT_PASSWORD=langfuse-local-only
