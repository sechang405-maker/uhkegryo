# Copy to .env.portfolio only after the separate key and public evaluation window are approved.
# Do not reuse the private Google/Codex environment file or its database password.
PORTFOLIO_POSTGRES_PASSWORD=
PORTFOLIO_SEARXNG_SECRET=
PORTFOLIO_OPENROUTER_API_KEY=
PORTFOLIO_MODEL=
PORTFOLIO_FREE_MODEL_ALLOWLIST=
PORTFOLIO_MODEL_CATALOG_FILE=
PORTFOLIO_MODEL_CATALOG_MAX_AGE_SECONDS=3600
PORTFOLIO_PUBLIC_ORIGIN=
# Use an ISO-8601 timestamp for an automatic close, or exactly `disabled`
# when the host is managed only with the explicit start/stop scripts.
PORTFOLIO_EVALUATION_ENDS_AT=disabled
PORTFOLIO_LLM_TIMEOUT_SECONDS=180
PORTFOLIO_FRONTEND_PORT=3120
PORTFOLIO_DB_PORT=55434
PORTFOLIO_SEARXNG_PORT=8081
PORTFOLIO_API_PORT=8000
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Hybrid only: same server-only value in the local gateway and Vercel project.
PORTFOLIO_GATEWAY_SECRET=
